# ===== NiftyBot configuration (copy to .env; deploy/setup_gcp.sh does this for you) =====
# PAPER TRADING ONLY - no broker orders are ever sent. Keep .env private (chmod 600).

# --- Dashboard login (REQUIRED to use the website) ---
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=
COOKIE_SECURE=0            # set 1 only if you use https:// exclusively

# --- Market data (Upstox Analytics token is primary; Yahoo is the fallback) ---
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_YAHOO_FALLBACK_ENABLED=true

# --- Telegram (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SCAN_SUMMARY=daily   # daily = one end-of-day summary | every = after each scan | off

# --- Optional news screening (negative news blocks a buy) ---
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
REQUIRE_NEWS_CONFIRMATION=false

# --- Paper account & risk ---
TRADING_CAPITAL_INR=100000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT_OF_CAPITAL=10   # hard cap for ONE stock (% of capital)
MAX_OPEN_POSITIONS=15
MAX_BUYS_PER_SCAN=3
MAX_TRADES_PER_DAY=10
SLOT_RESERVE_FRACTION=0.5      # keep this share of an average slot free for each still-empty slot
ALLOC_STRENGTH_MIN=0.75        # size multiplier for a barely-qualifying signal
ALLOC_STRENGTH_MAX=1.25        # size multiplier for a top-scoring signal
MAX_DAILY_LOSS_PCT=2.0
COOLING_PERIOD_HOURS=48
MAX_HOLD_SESSIONS=15              # Short-Term max holding in sessions (5-20 = 1-4 weeks)
BREAKEVEN_AT_R=1.0             # Short-Term: stop to break-even after +1R of open profit (0 = off)
COST_PCT_PER_SIDE=0.10

# --- Universe / liquidity filters ---
MIN_STOCK_PRICE=5               # lower-priced / penny stocks allowed if liquidity & quality filters pass
PENNY_PRICE_BELOW=20           # label only
MAX_SPREAD_PCT=1.0             # skip if best bid/ask spread is wider (when depth is in the quote)
MAX_PARTICIPATION_PCT=1.0      # order value <= this % of average daily turnover
MAX_ERRATIC_JUMPS=3            # >= N daily moves of +/-9.5% in 10 sessions = skipped
MAX_STOCK_PRICE=5000
MIN_AVG_DAILY_VOLUME=100000
MIN_AVG_DAILY_TURNOVER_INR=20000000

# --- Strategy (score out of 100) ---
MIN_SIGNAL_SCORE=70
WATCH_SCORE=55
RSI_OVERHEATED=75
ATR_STOP_MULT=1.5
MAX_STOP_PCT=8
TARGET1_R=2.0
TARGET2_R=3.5
TRAIL_ATR_MULT=2.0

# --- Strategy classification (every buy is INTRADAY or SHORT_TERM; no long-term) ---
INTRADAY_ENABLED=true
INTRADAY_ENTRY_CUTOFF=13:30
INTRADAY_SQUARE_OFF=15:15
INTRADAY_ALLOW_CARRY=false     # true = explicit exception allowing overnight carry
INTRADAY_MIN_VOLUME_RATIO=2.0
INTRADAY_STOP_ATR_MULT=1.0
INTRADAY_MAX_STOP_PCT=3.0
INTRADAY_TARGET1_R=1.5
INTRADAY_TARGET2_R=2.5
MARKET_FILTER_ENABLED=true     # pause new entries on a clearly bearish index day / (Short-Term) trend
MARKET_BEARISH_DAY_PCT=-1.5

# --- Position monitoring on every 15-minute scan ---
MONITOR_WARN_SCORE=2
MONITOR_EXIT_SCORE=4
MONITOR_EXIT_CONFIRM_SCANS=2   # consecutive scans needed before a deviation exit (hysteresis)
AUTO_EXIT_ON_RECOMMENDATION=true
BREAKDOWN_TOLERANCE_ATR=0.5
GIVEBACK_PCT=50

# --- Next-day outlook ---
OUTLOOK_EVENING_TIME=16:00
OUTLOOK_MORNING_TIME=08:30
GIFT_NIFTY_TICKER=             # optional Yahoo ticker used as an index-futures proxy

# --- Scheduling ---
SCAN_INTERVAL_MINUTES=15
POSITION_CHECK_MINUTES=5
SCAN_BATCH_SIZE=400        # stocks per scan; the whole list (~2,600) is covered by rotation
SCAN_WORKERS=6
ENTRY_WINDOW_START=10:00
ENTRY_WINDOW_END=14:30

# Extra NSE holidays, comma-separated YYYY-MM-DD (the built-in list covers 2026)
NSE_HOLIDAYS_EXTRA=
